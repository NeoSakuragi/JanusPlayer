<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:background="#222222"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="12dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Account -->
            <LinearLayout android:id="@+id/settingLogout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logout" android:textColor="#FF5252" android:textSize="15sp" />
                <TextView android:id="@+id/tvLogoutStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Logged in" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Theme -->
            <LinearLayout android:id="@+id/settingTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theme" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvThemeValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Updates section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/sectionUpdates"
                android:text="UPDATES"
                android:textColor="#7986CB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="8dp" />

            <LinearLayout android:id="@+id/settingCheckAppUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check for app update" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvAppUpdateStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to check" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/settingCheckLibrary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check for library update" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvLibraryUpdateStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap to check" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Server URL -->
            <LinearLayout android:id="@+id/settingServerUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Server URL" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvServerUrlValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Downloads -->
            <LinearLayout android:id="@+id/settingDownloads" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Downloads" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvDownloadsStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage offline episodes" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- AnkiWeb section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/sectionAnkiWeb"
                android:text="ANKIWEB"
                android:textColor="#7986CB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="24dp" />

            <LinearLayout android:id="@+id/settingAnkiLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AnkiWeb Account" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvAnkiLoginStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not connected" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/settingAnkiSync" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:background="@drawable/focus_highlight" android:focusable="true" android:clickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync to AnkiWeb" android:textColor="#EEEEEE" android:textSize="15sp" />
                <TextView android:id="@+id/tvAnkiSyncStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No pending cards" android:textColor="#888888" android:textSize="13sp" android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Playback section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/sectionPlayback"
                android:text="PLAYBACK"
                android:textColor="#7986CB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="24dp" />

            <LinearLayout
                android:id="@+id/settingHwdec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/focus_highlight"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hardware decoding"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvHwdecValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Off (software)"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Field mappings header (hidden for now) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/sectionFieldMappings"
                android:text=""
                android:visibility="gone"
                android:textColor="#7986CB"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="24dp" />

            <!-- Dynamic field mapping container -->
            <LinearLayout
                android:id="@+id/fieldMappingsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
